# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-from-botfather
# Comma-separated Telegram user IDs allowed to approve deposits.
ADMIN_TELEGRAM_IDS=123456789

# --- Database ---
DATABASE_URL=postgresql://yeneshop:yeneshop@localhost:5432/yeneshop?schema=public

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- HubX Reseller API ---
# Full base URL including the version prefix.
HUBX_API_URL=https://open-greeting-glow-production.up.railway.app/api/public/reseller/v1
HUBX_API_KEY=rsk_live_your_reseller_key

# --- Pricing ---
# Fallback rate used until an operator overrides it in the Config table.
DEFAULT_USDT_ETB_RATE=160
# Product sync interval (cron expression). Default: every 5 minutes.
PRODUCT_SYNC_CRON=*/5 * * * *
