# ====================================================================
# ATKE DIGITAL STORE - HIGH PERFORMANCE PLESK / APACHE CONFIGURATION
# ====================================================================

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

# Prevent directory indexing
Options -Indexes

# Security: Deny direct browser access to sensitive files
<FilesMatch "(\.env|\.sql|\.git|composer\.json|package\.json|deploy\.md)$">
    Require all denied
</FilesMatch>

# Enable CORS for Telegram WebApp
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Telegram-Init-Data"
</IfModule>

# GZIP Compression for ultra-fast asset delivery
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Browser & Telegram Webview Caching (Instant load on open)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|woff2)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=300, stale-while-revalidate=3600"
    </FilesMatch>
</IfModule>

# Ensure PHP 8.x handles PHP files
<IfModule mod_mime.c>
    AddType application/x-httpd-php .php
</IfModule>
