# ==========================================================
# STRICT SECURITY: Prevent Remote Code Execution (RCE) in Uploads
# ==========================================================

# 1. Disable execution of scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|pl|py|cgi|sh|bash|exe|bin|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Prevent CGI execution
Options -ExecCGI -Indexes

# 3. Disable PHP engine if mod_php is present
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 4. Only allow genuine image extensions to be served
<FilesMatch "\.(jpg|jpeg|png|webp|gif|svg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>
