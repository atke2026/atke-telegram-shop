# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-from-botfather
# Comma-separated Telegram user IDs allowed to approve deposits.
ADMIN_TELEGRAM_IDS=123456789

# --- Database ---
DATABASE_URL=postgresql://yeneshop:yeneshop@127.0.0.1:5433/yeneshop?schema=public

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- HubX Reseller API ---
# Full base URL including the version prefix.
HUBX_API_URL=https://open-greeting-glow-production.up.railway.app/api/public/reseller/v1
HUBX_API_KEY=rsk_live_your_reseller_key

# --- Web app API ---
WEB_API_PORT=8080
WEB_API_HOST=0.0.0.0
# Comma-separated CORS allowlist. Leave empty in development to reflect any origin.
WEB_APP_ORIGINS=http://localhost:5173
# How long a Telegram initData string stays valid (seconds).
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Pricing ---
# Fallback rate used until an operator overrides it in the Config table.
DEFAULT_USDT_ETB_RATE=2000
# Product sync interval (cron expression). Default: every 5 minutes.
PRODUCT_SYNC_CRON=*/5 * * * *
