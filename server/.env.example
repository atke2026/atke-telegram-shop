# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Telegram ---
# Bot account: @suqet_bot
BOT_TOKEN=123456:ABC-your-token-from-botfather
# Comma-separated Telegram user IDs allowed to approve deposits.
ADMIN_TELEGRAM_IDS=123456789
# Public channel used for announcements and the required-membership gate.
# The bot must be an administrator so it can verify other users.
ANNOUNCEMENT_CHANNEL=@suq_et
# Enable only after the channel exists and this bot is an administrator.
CHANNEL_MEMBERSHIP_REQUIRED=false

# --- Database ---
DATABASE_URL=postgresql://suq:suq@127.0.0.1:5433/suq?schema=public

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- YeneShop private reseller API ---
# Create a LIVE key from Suq's reseller account in YeneShop. Never expose it
# to the web app; only this server makes reseller requests.
YENESHOP_API_URL=https://yeneshop.example/api/reseller/v1
YENESHOP_API_KEY=ysk_live_your_reseller_key

# --- Web app API ---
WEB_API_PORT=8080
WEB_API_HOST=0.0.0.0
# Public Mini App URL. BotFather must use the same URL.
WEB_APP_URL=http://localhost:5173
# Comma-separated CORS allowlist. Leave empty in development to reflect any origin.
WEB_APP_ORIGINS=http://localhost:5173
# Where web-app receipt uploads are stored. Must sit outside server/, which a
# deploy replaces wholesale. Empty uses <repo>/data/receipts.
RECEIPTS_DIR=
# Full database + upload archives. Empty uses <repo>/data/backups.
BACKUPS_DIR=
# How long a Telegram initData string stays valid (seconds).
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Catalogue and delayed-order reconciliation ---
# Product sync interval (cron expression). The same job reconciles YeneShop
# orders which are awaiting manual delivery.
PRODUCT_SYNC_CRON=*/5 * * * *
