generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountScope {
  /// Applies to every product in the catalogue.
  ALL
  /// Applies to one product.
  PRODUCT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  // Telegram file_id of the profile photo, not an HTTP URL: resolving one
  // requires the bot token, which must never be persisted in a stored link.
  avatarUrl  String?
  // Wallet balance in ETB. Decimal(18,2) — never use float for money.
  balanceETB Decimal  @default(0) @db.Decimal(18, 2)
  isBanned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deposits Deposit[]
  orders   Order[]

  @@map("users")
}

model Deposit {
  id             String        @id @default(uuid())
  userId         String
  amountETB      Decimal       @db.Decimal(18, 2)
  // Telegram file_id of the receipt screenshot.
  screenshotUrl  String
  status         DepositStatus @default(PENDING)
  reviewedBy     BigInt?
  reviewedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@map("deposits")
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  productId      String
  productName    String
  quantity       Int         @default(1)
  // What the customer paid, and what it cost us upstream.
  pricePaidETB   Decimal     @db.Decimal(18, 2)
  /// What the product would have cost without a discount.
  listPriceETB   Decimal?    @db.Decimal(18, 2)
  discountETB    Decimal     @default(0) @db.Decimal(18, 2)
  discountId     String?
  costUSDT       Decimal     @db.Decimal(18, 6)
  status         OrderStatus @default(PENDING)
  hubxOrderId    String?
  deliveredItems Json?
  failureReason  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model Product {
  id              String   @id
  slug            String   @unique
  name            String
  description     String?
  // Operator-written product page. Survives syncs; wins over `description`.
  descriptionOverride String? @db.Text
  stock           Int      @default(0)
  isActive        Boolean  @default(true)
  costPriceUSDT   Decimal  @db.Decimal(18, 6)
  // Markup applied on top of the converted ETB cost.
  markupETB       Decimal  @default(0) @db.Decimal(18, 2)
  // Operator-set retail price. When present it wins over cost*rate+markup and
  // stays put as the exchange rate moves.
  priceOverrideETB Decimal? @db.Decimal(18, 2)
  sellingPriceETB Decimal  @db.Decimal(18, 2)
  updatedAt       DateTime @updatedAt

  orders    Order[]
  discounts Discount[]

  @@map("products")
}

/// A price reduction, either across the catalogue or on a single product.
/// When several could apply, the one worth most to the customer wins — they
/// never stack, so a combination cannot quietly drop a price below cost.
model Discount {
  id        String        @id @default(uuid())
  scope     DiscountScope
  /// Set when scope is PRODUCT, null for a store-wide discount.
  productId String?
  type      DiscountType
  /// A percentage (0-100) when type is PERCENT, otherwise an ETB amount.
  value     Decimal       @db.Decimal(18, 2)
  label     String?
  isActive  Boolean       @default(true)
  /// Optional window; null on either side means unbounded in that direction.
  startsAt  DateTime?
  endsAt    DateTime?

  createdByTelegramId BigInt?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, scope])
  @@index([productId])
  @@map("discounts")
}

/// Membership *is* the permission: a telegramId present here is an admin.
/// Seeded from ADMIN_TELEGRAM_IDS only while the table is empty, so grants and
/// revocations made later are not undone on the next restart.
model Admin {
  id                String   @id @default(uuid())
  telegramId        BigInt   @unique
  /// Who granted it — null for the operators seeded from the environment.
  addedByTelegramId BigInt?
  note              String?
  createdAt         DateTime @default(now())

  @@map("admins")
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("config")
}
